  "description": "Obsidian 阅读知识库到可编辑剪映草稿的自动化工作流",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "node scripts/init.mjs",
    "check": "node scripts/check.mjs",
    "workflow:prepare": "node scripts/prepare-jianying-workflow.mjs",
